{
    "elements": [
        {
            "type": "Select",
            "name": "DeviceType",
            "caption": "Output",
            "width": "400px",
            "onChange": "IPS_RequestAction($id, 'FormDeviceType', $DeviceType);",
            "options": [
                {
                    "caption": "Tile (playback in the browser of the visualization)",
                    "value": 0
                },
                {
                    "caption": "Chrome Cast (YouTube Music app)",
                    "value": 1
                }
            ]
        },
        {
            "type": "SelectInstance",
            "name": "CastInstance",
            "caption": "Chrome Cast instance",
            "width": "400px",
            "validModules": [
                "{9034A9D8-F004-22EA-9391-BF2E5E1CAB31}"
            ]
        },
        {
            "type": "ValidationTextBox",
            "name": "PlayerName",
            "caption": "Name of this player on the device (empty: name of this instance)",
            "width": "520px"
        },
        {
            "type": "Select",
            "name": "EnableVariables",
            "caption": "Status variables",
            "width": "400px",
            "options": [
                {
                    "caption": "On",
                    "value": 0
                },
                {
                    "caption": "Off",
                    "value": 2
                }
            ]
        },
        {
            "type": "Label",
            "name": "VariablesHint",
            "caption": "Switching off deletes the status variables (including their archive data) and the cover image of this instance when the changes are applied."
        },
        {
            "type": "Select",
            "name": "ControlMode",
            "caption": "Devices the tile can control",
            "width": "400px",
            "onChange": "IPS_RequestAction($id, 'FormControlMode', $ControlMode);",
            "options": [
                {
                    "caption": "All players of the account",
                    "value": 0
                },
                {
                    "caption": "Only this device",
                    "value": 1
                },
                {
                    "caption": "Selected players",
                    "value": 2
                }
            ]
        },
        {
            "type": "List",
            "name": "ControlDevices",
            "caption": "Players the tile can control",
            "rowCount": 4,
            "add": true,
            "delete": true,
            "columns": [
                {
                    "caption": "Player",
                    "name": "InstanceID",
                    "width": "auto",
                    "add": 0,
                    "edit": {
                        "type": "SelectInstance",
                        "validModules": [
                            "{432AD6E7-A9AC-44D5-A26E-962C77035C9D}"
                        ]
                    }
                }
            ]
        },
        {
            "type": "Select",
            "name": "VideoDisplay",
            "caption": "Show video",
            "width": "400px",
            "options": [
                {
                    "caption": "Floating window (movable)",
                    "value": 0
                },
                {
                    "caption": "In the tile instead of the cover (from 200×200 px)",
                    "value": 1
                }
            ]
        },
        {
            "type": "CheckBox",
            "name": "HiddenPlayback",
            "caption": "Continue playback without a visible player"
        },
        {
            "type": "Label",
            "name": "HiddenHint",
            "caption": "The YouTube API Services Policies require a visible player of at least 200×200 px. Hidden playback is at your own risk."
        }
    ],
    "actions": [
        {
            "type": "ExpansionPanel",
            "name": "Requests",
            "caption": "Lounge requests today",
            "items": [
                {
                    "type": "List",
                    "rowCount": 3,
                    "add": false,
                    "delete": false,
                    "columns": [
                        {
                            "caption": "Category",
                            "name": "Category",
                            "width": "auto"
                        },
                        {
                            "caption": "Requests",
                            "name": "Requests",
                            "width": "110px"
                        },
                        {
                            "caption": "Errors",
                            "name": "Errors",
                            "width": "90px"
                        }
                    ],
                    "values": []
                }
            ]
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "error",
            "caption": "Not connected to a YouTube Music Account"
        },
        {
            "code": 202,
            "icon": "error",
            "caption": "No Chrome Cast instance selected"
        }
    ]
}
